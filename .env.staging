# Environment Configuration for riks-context-engine (staging)

# Core
ENVIRONMENT=staging
PYTHONPATH=/app

# Data
DATA_DIR=/app/data

# ChromaDB (embedded, no external DB needed)
CHROMA_HOST=localhost
CHROMA_PORT=8000

# Ollama.
# NOTE: inside the container `localhost` is the CONTAINER, not the host.
# The compose overlay adds host.docker.internal:host-gateway, so the
# in-container URL must point at host.docker.internal.
OLLAMA_HOST=http://host.docker.internal:11434
OLLAMA_MODEL=gemma4:31b

# LLM Provider (options: ollama, openai, anthropic)
LLM_PROVIDER=ollama

# OpenAI (if using)
# OPENAI_API_KEY=sk-...

# Anthropic (if using)
# ANTHROPIC_API_KEY=sk-ant-...

# Semantic Memory
SEMANTIC_DB_PATH=/app/data/semantic.db

# Episodic Memory
EPISODIC_STORAGE_PATH=/app/data/episodic.json

# Procedural Memory
PROCEDURAL_STORAGE_PATH=/app/data/procedural.json

# Logging
LOG_LEVEL=DEBUG

# Test/Staging.
# STAGING_API_URL is the HOST-side base URL used by the scripts
# (staging.sh / test-staging.sh); the container itself serves on 8000
# and is published to 8001 by the compose overlay.
TEST_MODE=true
STAGING_API_URL=http://localhost:8001

# [REPLACE_ME] - Replace with real credentials before use
# STAGING_DB_URL=postgres://user:password@localhost:5432/staging_db
# STAGING_REDIS_URL=redis://localhost:6379/0
